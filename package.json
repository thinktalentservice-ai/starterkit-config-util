{
  "name": "@devopsnext/starterkit-config-util",
  "version": "0.3.0",
  "description": "Framework-agnostic app-config resolution plus the secure-storage, auth-fetch and third-party-integration utilities shared by the Think Talent frontends. Mechanism only — every project keeps its own env files, service paths and environment names.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinktalentservice-ai/starterkit-config-util.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env-json": {
      "types": "./dist/env-json.d.ts",
      "import": "./dist/env-json.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:dist",
    "lint:dist": "node scripts/check-dist.mjs"
  },
  "peerDependencies": {
    "@devopsthink/react-security-util": ">=1.5.9",
    "jose": ">=6",
    "secure-ls": ">=2"
  },
  "peerDependenciesMeta": {
    "@devopsthink/react-security-util": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "secure-ls": {
      "optional": true
    }
  },
  "devDependencies": {
    "@devopsthink/react-security-util": "^1.5.9",
    "@types/node": "^22.10.5",
    "jose": "^6.2.3",
    "jsdom": "^26.1.0",
    "secure-ls": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "config",
    "environment",
    "secure-storage",
    "integrations",
    "fetch",
    "starterkit"
  ]
}
